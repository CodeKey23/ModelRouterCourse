*.log
*.log.*

# Test and coverage artifacts.
.pytest_cache/
.coverage
htmlcov/

# Keep local test suites out of the published branch.
/tests/
/rsl/tests/

# Virtual environments.
.venv/
venv/
env/
ENV/

# Editor and OS artifacts.
.vscode/
.idea/
*.swp
